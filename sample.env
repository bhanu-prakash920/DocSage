# Copy to .env and fill in what you have. Every key is optional:
# with no keys DocSage runs in offline mode (local embeddings, extractive answers).

# --- Language models (the first one set is used when DOCSAGE_LLM_PROVIDER=auto) ---
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# --- Optional services ---
TAVILY_API_KEY=            # web-search fallback for the agentic mode
LLAMA_CLOUD_API_KEY=       # only for DOCSAGE_PARSER=llamaparse

# --- Common overrides (all settings use the DOCSAGE_ prefix) ---
# DOCSAGE_LLM_PROVIDER=auto            # auto | anthropic | google | openai | ollama | offline
# DOCSAGE_LLM_MODEL=                   # e.g. claude-opus-5-5, gemini-flash-latest, gpt-5.4
# DOCSAGE_LLM_FAST_MODEL=              # e.g. claude-haiku-4-5
# DOCSAGE_EMBEDDING_PROVIDER=auto      # auto | google | openai | ollama | local | hash
# DOCSAGE_CHUNKING=semantic            # recursive | semantic | agentic | proposition
# DOCSAGE_DATA_DIR=data
# DOCSAGE_MAX_INGEST_COST_USD=2.0
# DOCSAGE_MAX_QUERY_COST_USD=0.25
# DOCSAGE_API_TOKEN=                   # require a bearer token for the API and UI
# DOCSAGE_OLLAMA_BASE_URL=http://localhost:11434
